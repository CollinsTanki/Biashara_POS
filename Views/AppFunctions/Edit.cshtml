@model Biashara_POS.DTOs.AppFunction.UpdateAppFunctionDto

@{
	ViewData["Title"] = "Edit App Function";
}
<h3>
	<i class="bi bi-pencil-square"></i>
	Edit Function
</h3>

<form asp-action="Edit">

	<input type="hidden" asp-for="AppFunctionId" />

	<div class="mb-3">
		<label>Function Name</label>
		<input asp-for="FunctionName" class="form-control" />
	</div>

	<div class="mb-3">
		<label>Module</label>
		<select asp-for="ModuleId"
				asp-items="ViewBag.Modules"
				class="form-control">
		</select>
	</div>

	<button class="btn btn-primary">
		<i class="bi bi-check-circle"></i>
		Update
	</button>

</form>