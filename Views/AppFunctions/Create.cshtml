@model Biashara_POS.DTOs.AppFunction.CreateAppFunctionDto

@{
	ViewData["Title"] = "Create App Function";
}
<h3>
	<i class="bi bi-plus-circle"></i>
	Create Function
</h3>

<form asp-action="Create">

	<div class="mb-3">
		<label>Function Name</label>
		<input asp-for="FunctionName" class="form-control" />
	</div>

	<div class="mb-3">
		<label>Module</label>
		<select asp-for="ModuleId"
				asp-items="ViewBag.Modules"
				class="form-control">
		</select>
	</div>

	<button class="btn btn-success">
		<i class="bi bi-save"></i>
		Save
	</button>

</form>