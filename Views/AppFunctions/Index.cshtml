@model IEnumerable<Biashara_POS.DTOs.AppFunction.AppFunctionDto>

@{
	ViewData["Title"] = "App Functions";
}
<div class="container mt-4">

	<h3>
		<i class="bi bi-gear"></i>
		Application Functions
	</h3>

	<a asp-action="Create" class="btn btn-primary mb-3">
		<i class="bi bi-plus-circle"></i> Add Function
	</a>

	<table class="table table-bordered table-hover">

		<thead class="table-dark">
			<tr>
				<th>Function</th>
				<th>Module</th>
				<th>Actions</th>
			</tr>
		</thead>

		<tbody>

			@foreach (var item in Model)
			{
				<tr>

					<td>
						<i class="bi bi-lightning-charge"></i>
						@item.FunctionName
					</td>

					<td>
						<i class="bi bi-box"></i>
						@item.ModuleName
					</td>

					<td>

						<a asp-action="Edit" asp-route-id="@item.AppFunctionId"
						   class="btn btn-warning btn-sm">

							<i class="bi bi-pencil-square"></i>
						</a>

						<a asp-action="Delete" asp-route-id="@item.AppFunctionId"
						   class="btn btn-danger btn-sm">

							<i class="bi bi-trash"></i>
						</a>

					</td>

				</tr>
			}

		</tbody>
	</table>

</div>