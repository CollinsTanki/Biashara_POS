@model Biashara_POS.DTOs.ProductDto

@{
    ViewData["Title"] = "Create Product";
}

<div class="container mt-4">

    <div class="card shadow">

        <!-- CARD HEADER -->
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-box-seam"></i> Create New Product
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- ===================== PRODUCT INFORMATION ===================== -->
                <h6 class="text-primary border-bottom pb-2 mb-3">Product Information</h6>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="ProductName" class="form-label"></label>
                        <input asp-for="ProductName" class="form-control" placeholder="Enter product name" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Barcode" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Barcode" id="barcodeInput" class="form-control" placeholder="Scan or generate barcode" />
                            <button type="button" class="btn btn-outline-secondary" onclick="generateBarcode()">
                                <i class="bi bi-upc-scan"></i> Generate
                            </button>
                        </div>
                        <span asp-validation-for="Barcode" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" id="isActiveCheck" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>

                <!-- ===================== PRODUCT CLASSIFICATION ===================== -->
                <h6 class="text-primary border-bottom pb-2 mb-3">Product Classification</h6>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="StockCategoryId" class="form-label"></label>
                        <select asp-for="StockCategoryId"
                                class="form-select"
                                asp-items="ViewBag.StockCategoryId"
                                id="StockCategoryId">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="StockCategoryId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StockSubCategoryId" class="form-label"></label>
                        <select asp-for="StockSubCategoryId"
                                class="form-select"
                                id="StockSubCategoryId">
                            <option value="">-- Select Sub Category --</option>
                        </select>
                        <span asp-validation-for="StockSubCategoryId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="StockMeasureId" class="form-label"></label>
                        <select asp-for="StockMeasureId" class="form-select" asp-items="ViewBag.StockMeasureId">
                            <option value="">-- Select Measure --</option>
                        </select>
                        <span asp-validation-for="StockMeasureId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="VatSetupId" class="form-label"></label>
                        <select asp-for="VatSetupId" class="form-select" asp-items="ViewBag.VatSetupId">
                            <option value="">-- Select VAT --</option>
                        </select>
                        <span asp-validation-for="VatSetupId" class="text-danger"></span>
                    </div>
                </div>

                <!-- ===================== PRICING ===================== -->
                <h6 class="text-primary border-bottom pb-2 mb-3">Pricing</h6>
                <div class="row mb-4">
                    <div class="col-md-4">
                        <label asp-for="BuyingPrice" class="form-label"></label>
                        <input asp-for="BuyingPrice" class="form-control" type="number" step="0.01" placeholder="Buying Price" />
                        <span asp-validation-for="BuyingPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SellingPrice" class="form-label"></label>
                        <input asp-for="SellingPrice" class="form-control" type="number" step="0.01" placeholder="Selling Price" />
                        <span asp-validation-for="SellingPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ReorderLevel" class="form-label"></label>
                        <input asp-for="ReorderLevel" class="form-control" type="number" placeholder="Reorder Level" />
                        <span asp-validation-for="ReorderLevel" class="text-danger"></span>
                    </div>
                </div>

                <!-- ===================== PRODUCT IMAGE ===================== -->
                <h6 class="text-primary border-bottom pb-2 mb-3">Product Image</h6>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="ImageFile" class="form-label"></label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" onchange="previewImage(event)" />
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 text-center">
                        <img id="imagePreview" src="https://via.placeholder.com/150" class="img-thumbnail" style="max-height:150px;" />
                    </div>
                </div>

                <!-- ===================== BUTTONS ===================== -->
                <div class="border-top pt-3">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Save Product
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/products/product-create.js"></script>
}