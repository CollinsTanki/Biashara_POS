@model IEnumerable<Biashara_POS.DTOs.InvoiceDto>

@{
    ViewData["Title"] = "Invoices";
}

<h2>Invoices</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Create Invoice</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Invoice No</th>
            <th>Date</th>
            <th>Customer</th>
            <th>Total</th>
            <th>Paid</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.InvoiceNumber</td>
                <td>@item.InvoiceDate.ToShortDateString()</td>
                <td>@item.CustomerName</td>
                <td>@item.GrandTotal</td>
                <td>@(item.IsPaid ? "Yes" : "No")</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.InvoiceId"
                       class="btn btn-info btn-sm">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>