@model Biashara_POS.DTOs.PaymentModeDto

@{
    ViewData["Title"] = "Add Payment Mode";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-3">
        <label asp-for="ModeName"><i class="fas fa-money-bill-wave"></i> Mode Name</label>
        <input asp-for="ModeName" class="form-control" />
        <span asp-validation-for="ModeName" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"><i class="fas fa-toggle-on"></i> Active</label>
    </div>

    <button type="submit" class="btn btn-success">
        <i class="fas fa-save"></i> Save
    </button>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}