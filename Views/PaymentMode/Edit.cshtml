@model Biashara_POS.DTOs.PaymentModeDto

@{
    ViewData["Title"] = "Edit Payment Mode";
}

<h2><i class="fas fa-edit"></i> Edit Payment Mode</h2>

<form asp-action="Edit" method="post">
    <!-- Hidden field for ID -->
    <input type="hidden" asp-for="PaymentModeId" />

    <div class="form-group mb-3">
        <label asp-for="ModeName"><i class="fas fa-money-bill-wave"></i> Mode Name</label>
        <input asp-for="ModeName" class="form-control" />
        <span asp-validation-for="ModeName" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"><i class="fas fa-toggle-on"></i> Active</label>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save"></i> Save Changes
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

