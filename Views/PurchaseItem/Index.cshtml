@model IEnumerable<Biashara_POS.DTOs.PurchaseItemViewDto>

<h2>Purchase Items</h2>

<a asp-action="Create" class="btn btn-primary">Add Item</a>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Purchase ID</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.PurchaseId</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice</td>
                <td>@item.TotalPrice</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.PurchaseItemId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.PurchaseItemId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>