@model IEnumerable<Biashara_POS.DTOs.PurchaseItemViewDto>

@{
    ViewData["Title"] = "Purchase Items";
}

<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-bag-check-fill"></i> Purchase Items
        </h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle"></i> Add New
        </a>
    </div>

    <!-- CARD -->
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-list-check"></i> All Purchase Items</h5>
        </div>
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-light text-uppercase small">
                        <tr>
                            <th>Purchase</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                            <th class="text-center" style="width:180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PurchaseNumber</td>
                                <td>@item.ProductName</td>
                                <td><span class="badge bg-info text-dark">@item.Quantity</span></td>
                                <td>KSh @item.UnitPrice.ToString("N2")</td>
                                <td class="fw-bold text-success">KSh @item.Total.ToString("N2")</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.PurchaseItemId" class="btn btn-sm btn-warning me-1">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.PurchaseItemId" class="btn btn-sm btn-info text-white me-1">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.PurchaseItemId" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>