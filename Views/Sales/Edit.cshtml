@model Biashara_POS.DTOs.SaleEditDto

@{
    ViewData["Title"] = "Edit Sale";
}

<h2>Edit Sale</h2>

<form asp-action="Edit">

    <input type="hidden" asp-for="SaleId" />

    <div class="mb-3">
        <label class="form-label">Customer</label>
        <select asp-for="CustomerId"
                asp-items="ViewBag.Customers"
                class="form-control">
            <option value="">Walk-in Customer</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Total Amount</label>
        <input asp-for="TotalAmount" class="form-control" />
        <span asp-validation-for="TotalAmount" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsCreditSale" class="form-check-input" />
        <label class="form-check-label">
            Credit Sale
        </label>
    </div>

    <div class="mb-3">
        <label class="form-label">Balance</label>
        <input asp-for="Balance" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Update Sale
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}