@model IEnumerable<Biashara_POS.DTOs.StockMeasureDto>

@{
    ViewData["Title"] = "Stock Measures";
}

<div class="container mt-4">

    <h2 class="mb-3">Stock Measures</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Measure
        </a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Measure Name</th>
                <th>Initials</th>
                <th width="180px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MeasureName</td>
                    <td>@item.Initials</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.StockMeasureId"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.StockMeasureId"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this measure?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>