@{
    var currentYear = DateTime.Now.Year;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BiasharaPOS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ===== HEADER ===== -->
    <header class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top px-3">
        <div class="container-fluid d-flex justify-content-between align-items-center">

            <!-- Left links -->
            <div class="d-flex align-items-center">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold me-3">
                    <i class="bi bi-shop"></i> BiasharaPOS
                </a>
                <ul class="navbar-nav me-auto d-flex flex-row">
                    <li class="nav-item me-2">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Privacy" class="nav-link">Privacy</a>
                    </li>
                </ul>
            </div>

            <!-- Right links -->
            <div class="d-flex align-items-center">
                <!-- Notifications -->
                <div class="dropdown me-3">
                    <a class="position-relative nav-link" data-bs-toggle="dropdown" style="cursor:pointer;">
                        <i class="bi bi-bell fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge bg-danger rounded-pill">
                            0
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li class="dropdown-header fw-bold">Notifications</li>
                        <li><a class="dropdown-item" href="#">Low Stock Alert</a></li>
                        <li><a class="dropdown-item" href="#">New Sale Recorded</a></li>
                        <li><a class="dropdown-item" href="#">System Update</a></li>
                    </ul>
                </div>

                <!-- Login/Register -->
                <partial name="_LoginPartial" />
            </div>

        </div>
    </header>

    <div class="d-flex">

        <!-- ===== SIDEBAR ===== -->
        <aside class="sidebar bg-dark text-white p-3 sticky-top vh-100">
            <h5 class="fw-bold text-center mb-4"><i class="bi bi-speedometer2"></i> Admin Panel</h5>

            <ul class="nav nav-pills flex-column mb-auto">

                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index" class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-grid"></i> Dashboard
                    </a>
                </li>

                <div class="section-title">Management</div>
                <li class="nav-item">
                    <a asp-controller="Company" asp-action="Index" class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Company" ? "active" : "")">
                        <i class="bi bi-building"></i> Companies
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Branch" asp-action="Index" class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Branch" ? "active" : "")">
                        <i class="bi bi-diagram-3"></i> Branches
                    </a>
                </li>

                <div class="section-title">Inventory</div>
                <li>
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "StockCategory" || ViewContext.RouteData.Values["Controller"]?.ToString() == "StockSubCategory" ? "active" : "")"
                       data-bs-toggle="collapse" href="#inventoryMenu">
                        <i class="bi bi-box-seam"></i> Inventory <i class="bi bi-chevron-down float-end"></i>
                    </a>
                    <div class="collapse @(ViewContext.RouteData.Values["Controller"]?.ToString() == "StockCategory" || ViewContext.RouteData.Values["Controller"]?.ToString() == "StockSubCategory" ? "show" : "")" id="inventoryMenu">
                        <ul class="list-unstyled ps-3">
                            <li>
                                <a asp-controller="StockCategory" asp-action="Index"
                                   class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "StockCategory" ? "active" : "")">
                                    Stock Categories
                                </a>
                            </li>
                            <li>
                                <a asp-controller="StockSubCategory" asp-action="Index"
                                   class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "StockSubCategory" ? "active" : "")">
                                    Stock Sub Categories
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <li>
                    <a asp-controller="Product" asp-action="Index" class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")">
                        <i class="bi bi-box"></i> Products
                    </a>
                </li>

                <li>
                    <a href="#" class="nav-link text-white">
                        <i class="bi bi-cart"></i> Sales
                    </a>
                </li>
            </ul>

            <!-- Logout pinned bottom -->
            <div class="mt-auto">
                <hr class="text-secondary" />
                <a href="#" class="nav-link text-danger">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </aside>

        <!-- ===== MAIN CONTENT ===== -->
        <main class="flex-grow-1 content-area p-4">
            <h2 class="page-title fw-bold mb-4">@ViewData["Title"]</h2>
            @RenderBody()
        </main>
    </div>

    <footer class="text-center py-3 text-muted small">
        &copy; @currentYear - BiasharaPOS
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>