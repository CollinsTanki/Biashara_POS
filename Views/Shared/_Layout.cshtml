@{
    var currentYear = DateTime.Now.Year;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BiasharaPOS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
</head>
<body class="hold-transition sidebar-mini">

    <!-- ===== HEADER ===== -->
    <header class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top px-3">
        <div class="container-fluid d-flex justify-content-between align-items-center">

            <!-- LEFT SIDE MENU -->
            <div class="d-flex align-items-center">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold me-4">
                    <i class="bi bi-shop"></i> BiasharaPOS
                </a>

                <ul class="navbar-nav flex-row gap-2">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                </ul>
            </div>

            <!-- RIGHT SIDE ICONS -->
            <div class="d-flex align-items-center gap-3">

                <!-- MESSAGES DROPDOWN -->
                <div class="dropdown">
                    <a class="text-dark position-relative" href="#" role="button" id="messagesDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-envelope fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            3
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="messagesDropdown" style="width: 300px;">
                        <li class="dropdown-header">3 New Messages</li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-start" href="#">
                                <i class="bi bi-person-circle me-2 fs-4"></i>
                                <div>
                                    <strong>John Doe</strong><br />
                                    Hi! How are you?<br />
                                    <small class="text-muted">2 min ago</small>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-start" href="#">
                                <i class="bi bi-person-circle me-2 fs-4"></i>
                                <div>
                                    <strong>Mary Jane</strong><br />
                                    New VAT setup added.<br />
                                    <small class="text-muted">10 min ago</small>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-start" href="#">
                                <i class="bi bi-person-circle me-2 fs-4"></i>
                                <div>
                                    <strong>Admin</strong><br />
                                    System update completed.<br />
                                    <small class="text-muted">1 hr ago</small>
                                </div>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-center" href="#">See all messages</a></li>
                    </ul>
                </div>

                <!-- NOTIFICATIONS DROPDOWN -->
                <div class="dropdown">
                    <a class="text-dark position-relative" href="#" role="button" id="notificationsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-bell fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning">
                            5
                        </span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificationsDropdown" style="width: 300px;">
                        <li class="dropdown-header">5 Notifications</li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-check-circle text-success me-2"></i> VAT setup approved</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-exclamation-circle text-danger me-2"></i> Low stock alert</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-info-circle text-primary me-2"></i> New user registered</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-bell text-warning me-2"></i> System maintenance at 10 PM</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-star text-secondary me-2"></i> New report available</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-center" href="#">See all notifications</a></li>
                    </ul>
                </div>

                <!-- LOGIN / REGISTER -->
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">Login</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Register</a>

            </div>
        </div>
    </header>

    <div class="d-flex">

        <!-- ===== SIDEBAR ===== -->
        <aside class="sidebar bg-dark text-white p-3 sticky-top vh-100 d-flex flex-column">
            <h5 class="fw-bold text-center mb-4">
                <i class="bi bi-speedometer2"></i> Admin Panel
            </h5>

            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-grid"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item mt-3 text-uppercase text-secondary small fw-bold ps-3">Management</li>

                <li class="nav-item">
                    <a asp-controller="Company" asp-action="Index"
                       class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Company" ? "active" : "")">
                        <i class="bi bi-building"></i> Companies
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Branch" asp-action="Index"
                       class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Branch" ? "active" : "")">
                        <i class="bi bi-diagram-3"></i> Branches
                    </a>
                </li>

                <li class="nav-item mt-3 text-uppercase text-secondary small fw-bold ps-3">Inventory</li>

                @{
                    var inventoryControllers = new[] { "StockCategory", "StockSubCategory", "StockMeasure", "VatSetup" };
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var isInventoryActive = inventoryControllers.Contains(currentController);
                }

                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center @(isInventoryActive ? "active" : "")"
                       data-bs-toggle="collapse" href="#inventoryMenu" role="button" aria-expanded="@(isInventoryActive ? "true" : "false")">
                        <span><i class="bi bi-box-seam"></i> Inventory</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>

                    <ul class="collapse list-unstyled ps-3 @(isInventoryActive ? "show" : "")" id="inventoryMenu">
                        <li>
                            <a asp-controller="StockCategory" asp-action="Index"
                               class="nav-link text-white @(currentController == "StockCategory" ? "active" : "")">
                                <i class="bi bi-list-ul"></i> Stock Categories
                            </a>
                        </li>
                        <li>
                            <a asp-controller="StockSubCategory" asp-action="Index"
                               class="nav-link text-white @(currentController == "StockSubCategory" ? "active" : "")">
                                <i class="bi bi-list"></i> Stock Sub Categories
                            </a>
                        </li>
                        <li>
                            <a asp-controller="StockMeasure" asp-action="Index"
                               class="nav-link text-white @(currentController == "StockMeasure" ? "active" : "")">
                                <i class="bi bi-rulers"></i> Stock Measures
                            </a>
                        </li>
                        <li>
                            <a asp-controller="VatSetup" asp-action="Index"
                               class="nav-link text-white @(currentController == "VatSetup" ? "active" : "")">
                                <i class="bi bi-percent"></i> VAT Setup
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="nav-item mt-2">
                    <a asp-controller="Product" asp-action="Index"
                       class="nav-link text-white @(currentController == "Product" ? "active" : "")">
                        <i class="bi bi-box"></i> Products
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Sales" asp-action="Index"
                       class="nav-link text-white @(currentController == "Sales" ? "active" : "")">
                        <i class="bi bi-cart"></i> Sales
                    </a>
                </li>
            </ul>

            <div class="mt-auto">
                <hr class="text-secondary" />
                <a href="#" class="nav-link text-danger">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </aside>

        <!-- ===== MAIN CONTENT ===== -->
        <main class="flex-grow-1 content-area p-4">
            <h2 class="page-title fw-bold mb-4">@ViewData["Title"]</h2>
            @RenderBody()
        </main>
    </div>

    <footer class="text-center py-3 text-muted small">
        &copy; @currentYear - BiasharaPOS
    </footer>

    <!-- REQUIRED SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/products/product-create.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>