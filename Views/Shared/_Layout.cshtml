@{
    var currentYear = DateTime.Now.Year;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BiasharaPOS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ===== HEADER ===== -->
    <header class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top px-3">
        <div class="container-fluid d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold me-3">
                    <i class="bi bi-shop"></i> BiasharaPOS
                </a>
            </div>

            <div class="d-flex align-items-center">
                <partial name="_LoginPartial" />
            </div>

        </div>
    </header>

    <div class="d-flex">

        <!-- ===== SIDEBAR ===== -->
        <aside class="sidebar bg-dark text-white p-3 sticky-top vh-100 d-flex flex-column">
            <h5 class="fw-bold text-center mb-4">
                <i class="bi bi-speedometer2"></i> Admin Panel
            </h5>

            <ul class="nav nav-pills flex-column mb-auto">

                <!-- Dashboard -->
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-grid"></i> Dashboard
                    </a>
                </li>

                <!-- Management Section -->
                <li class="nav-item mt-3 text-uppercase text-secondary small fw-bold ps-3">Management</li>

                <li class="nav-item">
                    <a asp-controller="Company" asp-action="Index"
                       class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Company" ? "active" : "")">
                        <i class="bi bi-building"></i> Companies
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Branch" asp-action="Index"
                       class="nav-link text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Branch" ? "active" : "")">
                        <i class="bi bi-diagram-3"></i> Branches
                    </a>
                </li>

                <!-- Inventory Section -->
                <li class="nav-item mt-3 text-uppercase text-secondary small fw-bold ps-3">Inventory</li>

                @{
                    var inventoryControllers = new[] { "StockCategory", "StockSubCategory", "StockMeasure" };
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var isInventoryActive = inventoryControllers.Contains(currentController);
                }

                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center @(isInventoryActive ? "active" : "")"
                       data-bs-toggle="collapse" href="#inventoryMenu" role="button" aria-expanded="@(isInventoryActive ? "true" : "false")">
                        <span><i class="bi bi-box-seam"></i> Inventory</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>

                    <ul class="collapse list-unstyled ps-3 @(isInventoryActive ? "show" : "")" id="inventoryMenu">
                        <li>
                            <a asp-controller="StockCategory" asp-action="Index"
                               class="nav-link text-white @(currentController == "StockCategory" ? "active" : "")">
                                Stock Categories
                            </a>
                        </li>
                        <li>
                            <a asp-controller="StockSubCategory" asp-action="Index"
                               class="nav-link text-white @(currentController == "StockSubCategory" ? "active" : "")">
                                Stock Sub Categories
                            </a>
                        </li>
                        <li>
                            <a asp-controller="StockMeasure" asp-action="Index"
                               class="nav-link text-white @(currentController == "StockMeasure" ? "active" : "")">
                                Stock Measures (Units)
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Products -->
                <li class="nav-item mt-2">
                    <a asp-controller="Product" asp-action="Index"
                       class="nav-link text-white @(currentController == "Product" ? "active" : "")">
                        <i class="bi bi-box"></i> Products
                    </a>
                </li>

                <!-- Sales -->
                <li class="nav-item">
                    <a asp-controller="Sales" asp-action="Index"
                       class="nav-link text-white @(currentController == "Sales" ? "active" : "")">
                        <i class="bi bi-cart"></i> Sales
                    </a>
                </li>

            </ul>

            <!-- Logout -->
            <div class="mt-auto">
                <hr class="text-secondary" />
                <a href="#" class="nav-link text-danger">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </aside>

        <!-- ===== MAIN CONTENT ===== -->
        <main class="flex-grow-1 content-area p-4">
            <h2 class="page-title fw-bold mb-4">@ViewData["Title"]</h2>
            @RenderBody()
        </main>
    </div>

    <footer class="text-center py-3 text-muted small">
        &copy; @currentYear - BiasharaPOS
    </footer>

    <!-- 🔥 REQUIRED FOR VALIDATION -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>