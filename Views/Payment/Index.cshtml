@model IEnumerable<Biashara_POS.DTOs.PaymentDto>

@{
    ViewData["Title"] = "Payments";
}
<h2><i class="bi bi-cash-stack"></i> Payments</h2>

<p>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add Payment
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Sale</th>
            <th>Mode</th>
            <th>Amount</th>
            <th>Date</th>
            <th>Reference</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SaleId</td>
                <td>@item.PaymentModeName</td>
                <td>@item.Amount.ToString("N2")</td>
                <td>@item.PaymentDate.ToShortDateString()</td>
                <td>@item.ReferenceNumber</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@item.PaymentId" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>