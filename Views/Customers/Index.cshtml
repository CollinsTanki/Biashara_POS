@model IEnumerable<Biashara_POS.DTOs.CustomerDto>

@{
	ViewData["Title"] = "Customers";
}
<div class="container mt-4">

<h3>
<i class="bi bi-people-fill"></i> Customers
</h3>

<a asp-action="Create" class="btn btn-primary mb-3">
<i class="bi bi-person-plus-fill"></i> Add Customer
</a>

<table class="table table-striped table-bordered">

<thead class="table-dark">
<tr>
<th>Name</th>
<th>Phone</th>
<th>Location</th>
<th>Credit Limit</th>
<th>Status</th>
<th></th>
</tr>
</thead>

<tbody>

@foreach(var item in Model)
{
<tr>

<td>@item.FullName</td>

<td>@item.PhoneNumber</td>

<td>@item.Location</td>

<td>@item.CreditLimit</td>

<td>
@if(item.IsActive)
{
<span class="badge bg-success">Active</span>
}
else
{
<span class="badge bg-danger">Inactive</span>
}
</td>

<td>

<a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-warning btn-sm">
<i class="bi bi-pencil-square"></i>
</a>

<a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-danger btn-sm">
<i class="bi bi-trash"></i>
</a>

</td>

</tr>
}

</tbody>
</table>

</div>