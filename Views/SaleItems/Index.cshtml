@model IEnumerable<Biashara_POS.DTOs.SaleItemIndexDto>

@{
    ViewData["Title"] = "Sale Items";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>
            <i class="bi bi-cart4 text-primary"></i> Sale Items
        </h3>

        <a asp-action="Create" asp-route-saleId="@ViewBag.SaleId" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Item
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-striped table-hover">

                <thead class="table-dark">

                    <tr>
                        <th><i class="bi bi-box"></i> Product</th>
                        <th><i class="bi bi-123"></i> Quantity</th>
                        <th><i class="bi bi-cash"></i> Unit Price</th>
                        <th><i class="bi bi-percent"></i> Discount</th>
                        <th><i class="bi bi-receipt"></i> VAT</th>
                        <th><i class="bi bi-calculator"></i> SubTotal</th>
                        <th width="120"><i class="bi bi-gear"></i> Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N2")</td>
                            <td>@item.Discount.ToString("N2")</td>
                            <td>@item.VatAmount.ToString("N2")</td>
                            <td class="fw-bold">@item.SubTotal.ToString("N2")</td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.SaleItemId"
                                   class="btn btn-sm btn-warning">

                                    <i class="bi bi-pencil-square"></i>
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>