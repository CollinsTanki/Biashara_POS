@model Biashara_POS.DTOs.SaleItemCreateDto

@{
    ViewData["Title"] = "Add Sale Item";
}

<div class="container mt-4">

    <h3 class="mb-3">
        <i class="bi bi-cart-plus text-success"></i> Add Product To Sale
    </h3>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create">

                <input type="hidden" asp-for="SaleId" value="@ViewBag.SaleId" />

                <div class="mb-3">

                    <label class="form-label">
                        <i class="bi bi-box"></i> Product
                    </label>

                    <select asp-for="ProductId"
                            asp-items="ViewBag.Products"
                            class="form-select">

                        <option value="">Select Product</option>

                    </select>

                    <span asp-validation-for="ProductId" class="text-danger"></span>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        <i class="bi bi-123"></i> Quantity
                    </label>

                    <input asp-for="Quantity" class="form-control" />

                    <span asp-validation-for="Quantity" class="text-danger"></span>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        <i class="bi bi-cash"></i> Unit Price
                    </label>

                    <input asp-for="UnitPrice" class="form-control" />

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        <i class="bi bi-percent"></i> Discount
                    </label>

                    <input asp-for="Discount" class="form-control" />

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        <i class="bi bi-receipt"></i> VAT Amount
                    </label>

                    <input asp-for="VatAmount" class="form-control" />

                </div>


                <div class="mt-4">

                    <button type="submit" class="btn btn-success">

                        <i class="bi bi-save"></i> Save Item

                    </button>

                    <a asp-action="Index"
                       asp-route-saleId="@ViewBag.SaleId"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i> Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}