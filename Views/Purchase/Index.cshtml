@model IEnumerable<Biashara_POS.DTOs.PurchaseViewDto>

@{
    ViewData["Title"] = "Purchases";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">
        <i class="bi bi-bag-check"></i> Purchases
    </h3>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New Purchase
    </a>
</div>

<div class="card shadow-sm">

    <div class="card-body">

        <table class="table table-striped table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Purchase ID</th>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Items</th>
                    <th>Total Amount</th>
                    <th>Payment Type</th>
                    <th width="180">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No purchases found
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var purchase in Model)
                    {
                        <tr>

                            <td>
                                <strong>#@purchase.PurchaseId</strong>
                            </td>

                            <td>
                                @purchase.PurchaseDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @purchase.SupplierName
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @purchase.ItemCount Items
                                </span>
                            </td>

                            <td>
                                <strong>KES @purchase.TotalAmount.ToString("N2")</strong>
                            </td>

                            <td>
                                @if (purchase.IsCredit)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Credit
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Cash
                                    </span>
                                }
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@purchase.PurchaseId"
                                   class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@purchase.PurchaseId"
                                   class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@purchase.PurchaseId"
                                   class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </a>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>
