@model Biashara_POS.DTOs.Users.UserCreateDto

@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid mt-4">

    ```
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-person-plus-fill text-primary"></i>
                Create System User
            </h2>

            <p class="text-muted mb-0">
                Add a new user to the POS system
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Users
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">

                    <!-- Full Name -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="FullName" class="form-label fw-semibold"></label>

                        <input asp-for="FullName" class="form-control" placeholder="Enter full name" />

                        <span asp-validation-for="FullName" class="text-danger"></span>

                    </div>


                    <!-- Email -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Email" class="form-label fw-semibold"></label>

                        <input asp-for="Email" class="form-control" placeholder="Enter email" />

                        <span asp-validation-for="Email" class="text-danger"></span>

                    </div>


                    <!-- Password -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Password" class="form-label fw-semibold"></label>

                        <input asp-for="Password" class="form-control" />

                        <span asp-validation-for="Password" class="text-danger"></span>

                    </div>


                    <!-- Position -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Position" class="form-label fw-semibold"></label>

                        <input asp-for="Position" class="form-control" placeholder="e.g Cashier, Manager" />

                        <span asp-validation-for="Position" class="text-danger"></span>

                    </div>


                    <!-- Address -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Address" class="form-label fw-semibold"></label>

                        <input asp-for="Address" class="form-control" placeholder="User address" />

                        <span asp-validation-for="Address" class="text-danger"></span>

                    </div>


                    <!-- Branch -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="BranchId" class="form-label fw-semibold">
                            Branch
                        </label>

                        <select asp-for="BranchId"
                                asp-items="ViewBag.Branches"
                                class="form-select">

                            <option value="">Select Branch</option>

                        </select>

                        <span asp-validation-for="BranchId" class="text-danger"></span>

                    </div>


                    <!-- User Group -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="UserGroupId" class="form-label fw-semibold">
                            User Group
                        </label>

                        <select asp-for="UserGroupId"
                                asp-items="ViewBag.UserGroups"
                                class="form-select">

                            <option value="">Select User Group</option>

                        </select>

                        <span asp-validation-for="UserGroupId" class="text-danger"></span>

                    </div>


                    <!-- Active Toggle -->
                    <div class="col-md-12 mb-3">

                        <div class="form-check form-switch">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive" class="form-check-label">
                                Active User
                            </label>

                        </div>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="mt-3">

                    <button type="submit" class="btn btn-primary">

                        <i class="bi bi-save"></i>
                        Save User

                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">

                        <i class="bi bi-x-circle"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>
    ```

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
