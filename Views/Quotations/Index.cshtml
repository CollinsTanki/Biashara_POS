@model IEnumerable<Biashara_POS.DTOs.QuotationDto>

@{
	ViewData["Title"] = "Quotations";
}
<h3 class="mb-3">
	<i class="bi bi-file-earmark-text"></i> Quotations
</h3>

<a asp-action="Create" class="btn btn-primary mb-3">
	<i class="bi bi-plus-circle"></i> New Quotation
</a>

<table class="table table-bordered table-striped">

	<thead class="table-dark">
		<tr>
			<th>Ref</th>
			<th>Customer</th>
			<th>Date</th>
			<th>Valid Until</th>
			<th>Total</th>
			<th>Status</th>
			<th></th>
		</tr>
	</thead>

	<tbody>

		@foreach (var item in Model)
		{
			<tr>

				<td>@item.RefNumber</td>

				<td>@item.CustomerName</td>

				<td>@item.CreatedDate.ToShortDateString()</td>

				<td>@item.ValidUntil.ToShortDateString()</td>

				<td>@item.TotalAmount</td>

				<td>

					@if (item.IsConfirmed)
					{
						<span class="badge bg-success">Confirmed</span>
					}
					else
					{
						<span class="badge bg-warning">Pending</span>
					}

				</td>

				<td>

					<a asp-action="Edit" asp-route-id="@item.QuotationId"
					   class="btn btn-warning btn-sm">
						<i class="bi bi-pencil"></i>
					</a>

					<a asp-action="Delete" asp-route-id="@item.QuotationId"
					   class="btn btn-danger btn-sm">
						<i class="bi bi-trash"></i>
					</a>

				</td>

			</tr>
		}

	</tbody>
</table>